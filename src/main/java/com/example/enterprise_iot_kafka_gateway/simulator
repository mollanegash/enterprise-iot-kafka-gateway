package com.example.enterprise_iot_kafka_gateway.simulator;

import com.example.enterprise_iot_kafka_gateway.model.SensorTelemetry;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.time.OffsetDateTime;
import java.util.List;
import java.util.Random;
/**
 * Simulated IoT device stream generator.
 * Periodically generates and logs randomized telemetry data for a mock fleet 
 * of industrial sensors to simulate high-throughput event streaming.
 * 
 * @author Molla Negash
 * @since 2026-07
 */

@Component
public class IotDeviceSimulator {

    private static final Logger logger = LoggerFactory.getLogger(IotDeviceSimulator.class);
    private final Random random = new Random();

    private final List<String> deviceIds = List.of(
        "sensor-line-alpha-01",
        "sensor-line-beta-02",
        "sensor-warehouse-gamma-03",
        "sensor-turbine-delta-04"
    );

    private final List<String> locations = List.of("Austin-DC1", "Dallas-Hub2", "Houston-Plant3");

    @Scheduled(fixedRate = 3000) // Runs every 3 seconds
    public void generateTelemetry() {
        String deviceId = deviceIds.get(random.nextInt(deviceIds.size()));
        String location = locations.get(random.nextInt(locations.size()));
        
        double temperature = 60.0 + (40.0 * random.nextDouble()); // 60°C to 100°C
        double pressure = 950.0 + (100.0 * random.nextDouble());  // 950hPa to 1050hPa
        String status = temperature > 92.0 ? "WARNING_HIGH_TEMP" : "HEALTHY";

        SensorTelemetry telemetry = new SensorTelemetry(
            deviceId,
            location,
            Math.round(temperature * 100.0) / 100.0,
            Math.round(pressure * 100.0) / 100.0,
            status,
            OffsetDateTime.now()
        );

        logger.info("Generated IoT Telemetry -> Device: {}, Temp: {}°C, Status: {}", 
            telemetry.deviceId(), telemetry.temperature(), telemetry.status());
    }
}