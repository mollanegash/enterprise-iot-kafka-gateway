package com.example.enterprise_iot_kafka_gateway.model;

import java.time.OffsetDateTime;
/**
 * Immutable data record representing an incoming IoT device telemetry payload.
 * Captures real-time metrics including environmental conditions, device status, and timestamps.
 * 
 * @author Molla Negash
 * @since 2026-07
 */

public record SensorTelemetry(
    String deviceId,
    String location,
    double temperature,
    double pressure,
    String status,
    OffsetDateTime timestamp
) {}